# =============================================================================
#  줄바꿈 고정
#
#  윈도우의 Git 은 기본값(core.autocrlf=true)으로 파일을 받을 때 줄 끝에
#  보이지 않는 문자(CR)를 붙인다. 그 파일이 구글 드라이브로 맥에 넘어가면
#  맥은 셸 스크립트 첫 줄을 "/bin/bash^M" 으로 읽어 실행을 거부한다.
#     zsh: bad interpreter: /bin/bash^M: no such file or directory
#  그래서 실행 스크립트는 플랫폼과 무관하게 줄바꿈을 못박는다.
# =============================================================================

# 기본: 아무 변환도 하지 않는다 — 저장소에 든 바이트 그대로 받는다.
* -text

# 맥·리눅스 실행 스크립트 — 반드시 LF
*.command  text eol=lf
*.sh       text eol=lf

# 윈도우 배치 파일 — 반드시 CRLF
*.bat      text eol=crlf
